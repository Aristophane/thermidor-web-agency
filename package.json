    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "google-auth-library": "^11.3.2",
    "nodemailer": "^10.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
