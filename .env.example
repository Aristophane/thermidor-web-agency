NODE_ENV=production
HOST=0.0.0.0
PORT=3000
BASE_URL=https://thermidor-agence-web.fr
# Docker compose: the application is reachable only through its reverse proxy.
TRUST_PROXY=1
DATABASE_PATH=/app/data/thermidor.sqlite
UPLOAD_DIR=/app/public/uploads
ADMIN_EMAIL=contact@thermidor-agence-web.fr
# Generate with: npm run admin:password
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -hex 32
SESSION_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Thermidor <contact@thermidor-agence-web.fr>

LEGAL_COMPANY=Thermidor
LEGAL_ADDRESS=
LEGAL_REGISTRATION=
LEGAL_DIRECTOR=
LEGAL_HOST=
LEGAL_PHONE=
